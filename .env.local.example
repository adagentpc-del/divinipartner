# ============================================================================
# Divini Partners — UNIFIED LOCAL STACK env contract
# ----------------------------------------------------------------------------
# Procure runs as a Vite SPA + an Express/Postgres backend (server/):
#   * Auth    = native email + password (server/src/auth.ts, HS256 session JWT
#               via jose, signed with SESSION_SECRET). Authentik/OIDC has been
#               fully retired from the auth path; do not reintroduce OIDC_* vars.
#   * DB      = plain Postgres (the AI Builder OS local PG at localhost:5433)
#   * Storage = local disk (FILE_STORAGE_DIR) or S3-compatible (STORAGE_PROVIDER=s3)
#
# Copy to `.env.local` and fill in. Build-time VITE_* vars are inlined into the
# SPA bundle; the rest are read by the backend at runtime.
# ============================================================================

# --- Database (plain local Postgres; no SSL needed on localhost) ------------
# Create the DB + apply db/apply-all.sql first (the consolidated schema; see
# AI_PROJECT_OS/15_KNOWN_ISSUES.md — db/schema.sql is an early snapshot only).
DATABASE_URL=postgres://aibos:CHANGE_ME@localhost:5433/divini_partners

# --- Session auth (native email + password) ---------------------------------
# Signs the HS256 session JWT (server/src/lib/session.ts). REQUIRED in
# production — the server throws at startup if unset, empty, or left as the
# dev fallback (forgeable sessions otherwise). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Admin gate -------------------------------------------------------------
# Comma-separated allowlist matched against the verified session email claim.
# Drives backend requireAdmin (server/src/routes/admin.ts) + the SPA admin UI.
ADMIN_ALLOWED_EMAILS=adagentpc@gmail.com

# --- File storage (local disk; replaces Supabase Storage) -------------------
# Uploads land under <FILE_STORAGE_DIR>/<companyId>/<packageId|buildingId>/...
FILE_STORAGE_DIR=/root/partners-files
# Secret used to sign short-lived (1h) download URLs (HMAC). Set a strong value.
DOWNLOAD_URL_SECRET=replace-with-a-long-random-string

# --- HTTP / serving ---------------------------------------------------------
PORT=3011
# Canonical https origin (no trailing slash). Used for CORS allowlist.
PUBLIC_APP_URL=http://localhost:3011
# Optional CORS allowlist (in addition to PUBLIC_APP_URL). Comma-separated.
# ALLOWED_ORIGINS=
# Sub-path the SPA is served under (default "/"). Must match VITE base at build.
BASE_PATH=/

# --- Email (transactional + claim outreach) --------------------------------
# Provider: "resend" (hosted) or "postal" (self-hosted). Empty = email disabled
# (every send is logged and skipped, nothing transmitted).
EMAIL_PROVIDER=resend
# Secret. Set the REAL key only on the server, never commit it here.
EMAIL_API_KEY=re_YOUR_RESEND_API_KEY
# Verified sender. The domain must be verified in Resend (DKIM/SPF in DNS).
EMAIL_FROM=Divini Partners <partners@divinipartners.com>
# Only for EMAIL_PROVIDER=postal:
# POSTAL_API_URL=https://postal.yourdomain.com

# ---- Venue revenue share (1% of gross, carved out of the platform fee) ----
# Legacy (V1) values. Superseded by the Pricing V2 block below once
# PRICING_V2=true; harmless to leave set either way.
VENUE_REVENUE_SHARE_RATE=0.01
# Max fraction of the platform fee the venue share may consume (0.5 => Premier
# tier fee splits 50/50 between platform and venue; richer tiers unaffected).
VENUE_SHARE_MAX_FEE_FRACTION=0.5

# --- Pricing V2 (on-top fee model; see AI_PROJECT_OS/23_DEPLOYMENT.md) ------
# Server flag. VITE_PRICING_V2 (below) must ALSO be set -- it is inlined into
# the SPA bundle at build time, so setting only the server flag leaves the
# public pricing copy showing the legacy model.
# PRICING_V2=true
# VITE_PRICING_V2=true
# Optional overrides (defaults shown):
# PLATFORM_FEE_RATE_V2=0.05
# VENUE_SHARE_OF_FEE_V2=0.2
# FEATURED_VENDOR_PRICE_USD=49
# SEAT_PRICE_USD=10          # auto $10 when PRICING_V2=true, else $5

# --- Money rail (deferred until ready to move real funds) -------------------
# Leave BOTH unset until Stripe Connect is wired and legal review has cleared
# (AI_PROJECT_OS/52_COMPLIANCE.md). Payouts and venue share stay queue-only
# (records correct, no money moves) while these are empty.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox         # sandbox | live
# PAYPAL_WEBHOOK_ID=

# --- Upload malware scanning (server/src/lib/uploadGuard.ts) ----------------
# Extension/MIME/magic-byte checks run unconditionally. Virus scanning is a
# separate, OFF-by-default seam requiring clamav-daemon installed on the
# host. A startup warning fires when this is left off in production so it's
# a visible decision, not a silent gap.
# AV_SCAN_ENABLED=true
# AV_CLAMDSCAN_PATH=clamdscan
# Max upload size in bytes (default 25 MB).
# UPLOAD_MAX_BYTES=26214400

# --- Local LLM (server/src/lib/llm.ts) ---------------------------------------
# Optional, best-effort only -- every feature that calls this falls back to
# deterministic logic on any failure or when left unconfigured. Defaults to a
# local Ollama server; only set the openai-compat block if pointing at a
# hosted OpenAI-compatible endpoint instead.
# LLM_PROVIDER=ollama        # ollama | openai-compat
# OLLAMA_URL=http://localhost:11434
# LLM_MODEL=llama3
# LLM_BASE_URL=              # openai-compat only
# LLM_API_KEY=                # openai-compat only

# --- Cloud storage + encryption at rest (optional; default is local disk) ---
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AES-256-GCM envelope encryption for stored objects (local or S3). Losing
# this key makes encrypted objects unrecoverable -- back it up separately.
# Generate with: openssl rand -base64 32
# STORAGE_ENCRYPTION_KEY=
