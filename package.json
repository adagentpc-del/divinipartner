{
  "name": "divini-partners",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Divini Partners - procurement marketplace (Vite SPA + Express/Postgres backend, native email/password auth, pluggable local-disk/S3 storage)",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src server/src",
    "build": "tsc && vite build",
    "build:server": "npm --prefix server install && npm --prefix server run build",
    "build:all": "npm run build && npm run build:server && rm -rf server/dist/public && cp -r dist server/dist/public",
    "start": "node --enable-source-maps server/dist/index.js",
    "preview": "vite preview",
    "app:build": "npm run build && npx cap sync",
    "cap:sync": "npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "assets:generate": "capacitor-assets generate",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "oidc-client-ts": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.0"
  }
}
